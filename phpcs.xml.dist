<?xml version="1.0"?>
<ruleset name="PHP-Serial">
    <description>Coding standard for PHP-Serial.</description>

    <file>src</file>
    <file>tests</file>
    <file>examples</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>

    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
